# Cloudflare TURN (Calls) credentials. Optional: without them the app uses STUN only.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Signaling Worker (signaling/). Optional: without it PeerJS uses its public broker.
# Local: ws://localhost:8787/  Production: wss://gameroom-signaling.<your-subdomain>.workers.dev/
NEXT_PUBLIC_SIGNALING_URL=
