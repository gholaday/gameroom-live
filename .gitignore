# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/signaling/node_modules
/signaling/.wrangler
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ROMs, BIOS, disc images. Never commit these.
*.sfc
*.smc
*.z64
*.n64
*.v64
*.chd
*.bin
*.cue
*.iso

# Local test ROMs
/roms/

# Emulator cores, downloaded by scripts/fetch-cores.mjs
/public/cores/
